# Copy to terraform.tfvars and adjust. Every variable is documented in variables.tf.

aws_region  = "us-east-1"
environment = "production"

github_repository = "your-org/callsign-server"
# Newer repositories sign Actions tokens with immutable subjects. Get the prefix with:
#   gh api repos/your-org/callsign-server/actions/oidc/customization/sub --jq .sub_claim_prefix
# github_subject_prefix = "repo:your-org@123456/callsign-server@7890123"

# Domains. DNS stays at Namecheap unless route53_zone_id is set.
domain_name   = "callsign.im"
api_subdomain = "api"
# app_url         = "https://app.callsign.im"
# site_url        = "https://callsign.im"
# route53_zone_id = "Z0123456789ABCDEFGHIJ"

# Cost versus availability.
single_nat_gateway = true
db_multi_az        = false
cache_num_nodes    = 1

# Sizing.
db_instance_class = "db.t4g.micro"
cache_node_type   = "cache.t4g.micro"
api_min_count     = 2
api_desired_count = 2
api_max_count     = 6

# Email. To use another SMTP provider instead of SES:
# enable_ses = false
# smtp_url   = "smtps://user:password@smtp.example.com:465"
# mail_from  = "Callsign <no-reply@callsign.im>"

# Set to false if the account already has a GitHub Actions OIDC provider.
create_github_oidc_provider = true
