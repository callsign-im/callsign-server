  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://callsign.im",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/callsign-im/callsign-server.git",
    "directory": "cli"
  },
  "keywords": [
    "callsign",
    "ai-agents",
    "mcp",
    "claude-code",
    "codex"
  ],
  "bin": {
